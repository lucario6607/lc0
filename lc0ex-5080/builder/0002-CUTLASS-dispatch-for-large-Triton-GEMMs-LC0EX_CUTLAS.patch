@@ -676,6 +676,17 @@ _SWEEP_MAIN = r"""
 #include <cuda_runtime.h>
 #include <cstdio>
 
+// Random operands: under a power cap, zeroed data lets the card clock higher
+// and favours tiles that lose on real activations.
+__global__ void lc0ex_sweep_fill(cutlass::half_t* p, size_t n, unsigned seed) {{
+  for (size_t i = blockIdx.x * (size_t)blockDim.x + threadIdx.x; i < n;
+       i += (size_t)gridDim.x * blockDim.x) {{
+    unsigned x = (unsigned)i * 2654435761u + seed;
+    x ^= x >> 13; x *= 0x5bd1e995u; x ^= x >> 15;
+    p[i] = cutlass::half_t(((x & 0xffff) / 65536.f - 0.5f) * 0.2f);
+  }}
+}}
+
 int main() {{
   void* d = nullptr;
   void* a = nullptr;
@@ -692,12 +703,13 @@ int main() {{
     std::printf("-1\n");
     return 0;
   }}
-  cudaMemset(d, 0, (size_t)kM * kN * sizeof(ElementC));
-  cudaMemset(a, 0, (size_t)kM * kK * sizeof(ElementA));
-  cudaMemset(b, 0, (size_t)kK * kN * sizeof(ElementB));
-  cudaMemset(bias, 0, (size_t)kN * sizeof(ElementC));
-  cudaMemset(skip, 0, (size_t)kM * kN * sizeof(ElementC));
-  cudaMemset(alpha, 0, sizeof(ElementC));
+  lc0ex_sweep_fill<<<256, 256>>>((cutlass::half_t*)d, (size_t)kM * kN, 1u);
+  lc0ex_sweep_fill<<<256, 256>>>((cutlass::half_t*)a, (size_t)kM * kK, 2u);
+  lc0ex_sweep_fill<<<256, 256>>>((cutlass::half_t*)b, (size_t)kK * kN, 3u);
+  lc0ex_sweep_fill<<<256, 256>>>((cutlass::half_t*)bias, (size_t)kN, 4u);
+  lc0ex_sweep_fill<<<256, 256>>>((cutlass::half_t*)skip, (size_t)kM * kN, 5u);
+  {{ const cutlass::half_t one(1.0f);
+    cudaMemcpy(alpha, &one, sizeof(one), cudaMemcpyHostToDevice); }}
 
   const int shared_bytes = (int)sizeof(SharedStorage);
   if (cudaFuncSetAttribute((const void*)&{entry},
@@ -710,7 +722,7 @@ int main() {{
                   (kN + ThreadblockShape::kN - 1) / ThreadblockShape::kN, 1);
   const dim3 block({threads}, 1, 1);
 
-  for (int i = 0; i < 20; ++i) {{
