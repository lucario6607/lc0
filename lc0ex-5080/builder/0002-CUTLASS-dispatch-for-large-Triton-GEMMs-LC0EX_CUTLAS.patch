     {entry}<<<grid, block, shared_bytes>>>({sweep_arguments});
   }}
   if (cudaDeviceSynchronize() != cudaSuccess) {{
@@ -722,7 +734,7 @@ int main() {{
   cudaEventCreate(&start);
   cudaEventCreate(&stop);
   cudaEventRecord(start);
-  for (int i = 0; i < 200; ++i) {{
