diff --git a/packages/lczero-triton/src/lczero_triton/bt4/kernels/matmul.py b/packages/lczero-triton/src/lczero_triton/bt4/kernels/matmul.py
index 64792be..400677d 100644
--- a/packages/lczero-triton/src/lczero_triton/bt4/kernels/matmul.py
+++ b/packages/lczero-triton/src/lczero_triton/bt4/kernels/matmul.py
@@ -1,5 +1,6 @@
 """Autotuned contiguous FP16 dense matrix multiplication family."""
 
+import os
 from collections.abc import Mapping
 from dataclasses import dataclass
 from typing import Literal, cast
@@ -575,6 +576,39 @@ def compile_matmul(specialization: MatmulSpecialization) -> KernelArtifact:
     )
 
 
+# Route large GEMMs to CUTLASS: on sm_120 its mma.sync pipeline beats the Triton
+# kernel by ~10 % at the encoder shapes. Small and skinny shapes stay on Triton.
+_CUTLASS_MIN_M = int(os.environ.get("LC0EX_CUTLASS_MIN_M", "0") or 0)
+_CUTLASS_MIN_N = 256
+_CUTLASS_MIN_K = 256
+
+
+# Exact shapes to route, as "MxNxK" (M may be "*" to match any batch).
+_CUTLASS_SHAPES = tuple(
+    tuple(part for part in shape.split("x"))
+    for shape in os.environ.get("LC0EX_CUTLASS_SHAPES", "").split(",")
+    if shape
+)
+
+
+def _use_cutlass(specialization: MatmulSpecialization) -> bool:
+    if specialization.output_f32:
+        return False
+    for m, n, k in _CUTLASS_SHAPES:
+        if (m in ("*", str(specialization.m)) and n == str(specialization.n)
+                and k == str(specialization.k)):
+            return True
+    if _CUTLASS_MIN_M <= 0:
+        return False
+    return (
+        specialization.m >= _CUTLASS_MIN_M
+        and specialization.n >= _CUTLASS_MIN_N
+        and specialization.k >= _CUTLASS_MIN_K
+        and specialization.n % 8 == 0
+        and specialization.k % 8 == 0
+    )
+
+
 def matmul(
     builder: ProgramBuilder,
     kernels: KernelCache,
@@ -588,6 +622,32 @@ def matmul(
     alpha: Buffer | None = None,
 ) -> None:
     """Append one contiguous row-major dense matrix multiplication."""
+    if _use_cutlass(specialization):
+        from lczero_triton.bt4.kernels.cutlass_matmul import (  # noqa: PLC0415
+            CutlassMatmulSpecialization,
+            cutlass_matmul,
+        )
+
+        cutlass_matmul(
+            builder,
+            kernels,
+            output,
+            activations,
+            weights,
+            CutlassMatmulSpecialization(
+                specialization.m,
+                specialization.n,
+                specialization.k,
+                specialization.architecture,
+                has_bias=specialization.has_bias,
+                activation=specialization.activation,
+                has_skip=specialization.has_skip,
+            ),
+            bias=bias if specialization.has_bias else None,
+            skip=skip if specialization.has_skip else None,
+            alpha=alpha if specialization.has_skip else None,
+        )
+        return
     builder.set_target(
         lc0ex_pb2.Target.VENDOR_NVIDIA,
         f"sm_{specialization.architecture}",
