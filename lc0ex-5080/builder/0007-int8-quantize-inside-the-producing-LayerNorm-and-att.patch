diff --git a/packages/lczero-triton/src/lczero_triton/bt4/kernels/int8_matmul.py b/packages/lczero-triton/src/lczero_triton/bt4/kernels/int8_matmul.py
index 073e056..4f92053 100755
--- a/packages/lczero-triton/src/lczero_triton/bt4/kernels/int8_matmul.py
+++ b/packages/lczero-triton/src/lczero_triton/bt4/kernels/int8_matmul.py
@@ -221,3 +221,174 @@ def carrier_layer(
             dtype=lc0ex_pb2.Buffer.DATA_TYPE_F32, alignment_bytes=256,
         ),
     )
+
+
+@triton.jit
+def _round_to_int8(values):
+    values = tl.where(values >= 0, tl.floor(values + 0.5), tl.ceil(values - 0.5))
+    return tl.minimum(tl.maximum(values, -127.0), 127.0).to(tl.int8)
+
+
+@triton.jit
+def _layer_norm_quantize_kernel(
+    output,
+    quantized,
+    input_,
+    gammas,
+    betas,
+    reciprocal_scale,
+    width: tl.constexpr,
+    epsilon: tl.constexpr,
+) -> None:
+    """LayerNorm one row to FP16 and also write it quantized for an int8 GEMM.
+
+    The int8 copy is taken from the FP16-rounded result, so it is exactly what a
+    separate quantize kernel would produce from `output`.
+    """
+    row = tl.program_id(0)
+    offsets = tl.arange(0, width)
+    values = tl.load(input_ + row * width + offsets).to(tl.float32)
+    mean = tl.sum(values, axis=0) / width
+    centered = values - mean
+    variance = tl.sum(centered * centered, axis=0) / width
+    normalized = centered / tl.sqrt(variance + epsilon)
+    result = (
+        normalized * tl.load(gammas + offsets).to(tl.float32)
+        + tl.load(betas + offsets).to(tl.float32)
+    ).to(tl.float16)
+    tl.store(output + row * width + offsets, result)
+    scaled = result.to(tl.float32) * tl.load(reciprocal_scale + offsets)
+    tl.store(quantized + row * width + offsets, _round_to_int8(scaled))
+
+
+_TWICE_HALF_MAX = tl.constexpr(131008.0)
+
+
+@triton.jit
+def _attention_quantize_kernel(
+    quantized,
+    qkv,
+    smolgen,
+    scale_ptr,
+    reciprocal_scale,
+    model_width: tl.constexpr,
+    head_depth: tl.constexpr,
+    heads_per_sample: tl.constexpr,
+) -> None:
+    """Fused attention (QK + Smolgen + softmax + V) writing int8 for the out-projection.
+
+    Same arithmetic as `_fused_attention_kernel`; the FP16 head output is
+    quantized with the out-projection's per-channel `r` instead of stored.
+    """
+    matrix = tl.program_id(0)
+    sample = matrix // heads_per_sample
+    head = matrix % heads_per_sample
+    scale = tl.load(scale_ptr)
+    stride_row: tl.constexpr = 3 * model_width
+    offs_m = tl.arange(0, 64)
+    offs_d = tl.arange(0, head_depth)
+    base = sample * (64 * stride_row) + head * head_depth
+    q = tl.load(qkv + base + offs_m[:, None] * stride_row + offs_d[None, :]).to(tl.float16)
+    k = tl.load(qkv + base + model_width + offs_m[:, None] * stride_row + offs_d[None, :]).to(tl.float16)
+    qk = tl.dot(q, tl.trans(k), out_dtype=tl.float16) * scale
+    logits = qk + tl.load(smolgen + matrix * 4096 + offs_m[:, None] * 64 + offs_m[None, :])
+    is_nan = logits != logits  # noqa: PLR0124
+    clamped = tl.minimum(tl.maximum(logits, -_TWICE_HALF_MAX), _TWICE_HALF_MAX)
+    logits = tl.where(is_nan, logits, clamped)
+    max_val = tl.max(logits, axis=1)
+    exp_val = tl.exp(logits - max_val[:, None])
+    sum_val = tl.sum(exp_val, axis=1)
+    probs = (exp_val / sum_val[:, None]).to(tl.float16)
+    v = tl.load(qkv + base + 2 * model_width + offs_m[:, None] * stride_row + offs_d[None, :]).to(tl.float16)
+    out_val = tl.dot(probs, v, out_dtype=tl.float16)
+    scaled = out_val.to(tl.float32) * tl.load(reciprocal_scale + head * head_depth + offs_d)[None, :]
+    offsets = sample * (64 * model_width) + head * head_depth + offs_m[:, None] * model_width + offs_d[None, :]
+    tl.store(quantized + offsets, _round_to_int8(scaled))
+
+
+@dataclass(frozen=True, slots=True)
+class LayerNormQuantizeSpecialization:
+    """LayerNorm of [rows, width] FP16 with an extra int8 output."""
+
+    rows: int
+    width: int
+    architecture: int
+    epsilon: float = 0.001
+
+
+@dataclass(frozen=True, slots=True)
+class AttentionQuantizeSpecialization:
+    """Fused smolgen attention writing int8 head outputs."""
+
+    attention_batches: int
+    model_width: int
+    head_depth: int
+    heads_per_sample: int
+    architecture: int
+
+
+def compile_layer_norm_quantize(s: LayerNormQuantizeSpecialization) -> KernelArtifact:
+    """Compile the LayerNorm + int8 quantization kernel."""
+    output = torch.empty((s.rows, s.width), dtype=torch.float16, device="cuda")
+    quantized = torch.empty((s.rows, s.width), dtype=torch.int8, device="cuda")
+    input_ = torch.zeros((s.rows, s.width), dtype=torch.float16, device="cuda")
+    vector16 = torch.zeros(s.width, dtype=torch.float16, device="cuda")
+    vector32 = torch.ones(s.width, dtype=torch.float32, device="cuda")
+    compiled = _layer_norm_quantize_kernel[(s.rows,)](
+        output, quantized, input_, vector16, vector16, vector32, s.width, s.epsilon, num_warps=4
+    )
+    return artifact_from_triton(compiled, grid=(s.rows, 1, 1), parameters=(_POINTER,) * 6)
+
+
+def compile_attention_quantize(s: AttentionQuantizeSpecialization) -> KernelArtifact:
+    """Compile the int8-output fused attention kernel."""
+    rows = s.attention_batches // s.heads_per_sample * 64
+    quantized = torch.empty((rows, s.model_width), dtype=torch.int8, device="cuda")
+    qkv = torch.zeros((rows, 3 * s.model_width), dtype=torch.float16, device="cuda")
+    smolgen = torch.zeros((s.attention_batches, 64, 64), dtype=torch.float16, device="cuda")
+    scale = torch.ones(1, dtype=torch.float16, device="cuda")
+    reciprocal = torch.ones(s.model_width, dtype=torch.float32, device="cuda")
+    compiled = _attention_quantize_kernel[(s.attention_batches,)](
+        quantized, qkv, smolgen, scale, reciprocal,
+        s.model_width, s.head_depth, s.heads_per_sample, num_warps=4,
+    )
+    return artifact_from_triton(compiled, grid=(s.attention_batches, 1, 1), parameters=(_POINTER,) * 5)
+
+
+def layer_norm_quantize(  # noqa: PLR0913
+    builder: ProgramBuilder,
+    kernels: KernelCache,
+    output: Buffer,
+    quantized: Buffer,
+    input_: Buffer,
+    gammas: Buffer,
+    betas: Buffer,
+    reciprocal_scale: Buffer,
+    specialization: LayerNormQuantizeSpecialization,
+) -> None:
+    """Append LayerNorm writing both FP16 and the consumer's int8 input."""
+    builder.set_target(lc0ex_pb2.Target.VENDOR_NVIDIA, f"sm_{specialization.architecture}")
+    kernel = kernels.get(compile_layer_norm_quantize, specialization)
+    builder.call(
+        kernel, output, quantized, input_, gammas, betas, reciprocal_scale,
+        readonly=[input_, gammas, betas, reciprocal_scale],
+    )
+
+
+def attention_quantize(  # noqa: PLR0913
+    builder: ProgramBuilder,
+    kernels: KernelCache,
+    quantized: Buffer,
+    qkv: Buffer,
+    smolgen: Buffer,
+    scale: Buffer,
+    reciprocal_scale: Buffer,
+    specialization: AttentionQuantizeSpecialization,
+) -> None:
+    """Append fused attention whose output is quantized for the out-projection."""
+    builder.set_target(lc0ex_pb2.Target.VENDOR_NVIDIA, f"sm_{specialization.architecture}")
+    kernel = kernels.get(compile_attention_quantize, specialization)
+    builder.call(
+        kernel, quantized, qkv, smolgen, scale, reciprocal_scale,
+        readonly=[qkv, smolgen, scale, reciprocal_scale],
+    )
