+def _carrier(
+    context: _BuildContext, prefix: str, block: str, out_width: int, in_width: int
+) -> tuple[Buffer, Buffer, Buffer, Buffer]:
+    """Declare a carrier layer's buffers once per executable."""
+    key = f"{prefix}/q1/{block}"
+    if key not in context.shared_buffers:
+        layer = carrier_layer(context.builder, prefix, block, out_width, in_width)
+        for suffix, buffer in zip(("/w", "/scale", "/bias", "/r"), layer, strict=True):
+            context.shared_buffers[key + suffix] = buffer
+    return tuple(  # type: ignore[return-value]
+        context.shared_buffers[key + suffix] for suffix in ("/w", "/scale", "/bias", "/r")
+    )
+
+
+# (batch size, id of an FP16 activation, carrier block) -> (activation, int8 copy)
+# written by the activation's producer. The activation is kept in the value so
+# its id cannot be reused while the entry exists.
+_QUANTIZED: dict[tuple[int, int, str], tuple[Buffer, Buffer]] = {}
+
+
+def _quantized_input(
+    context: _BuildContext,
+    activation: Buffer,
+    block: str,
+    reciprocal_scale: Buffer,
+    rows: int,
+    width: int,
+) -> Buffer:
+    """Return the int8 copy of `activation` for `block`, quantizing if no producer did."""
+    entry = _QUANTIZED.get((context.batch_size, id(activation), block))
+    if entry is not None:
+        return entry[1]
+    quantized = context.builder.temporary_buffer(size_bytes=rows * width, alignment_bytes=256)
+    quantize(
+        context.builder,
+        context.kernels,
+        quantized,
+        activation,
+        reciprocal_scale,
+        QuantizeSpecialization(rows, width, context.architecture),
+    )
+    return quantized
+
+
+def _layer_norm_for_int8(  # noqa: PLR0913
+    context: _BuildContext,
+    output: Buffer,
+    input_: Buffer,
+    gammas: Buffer,
+    betas: Buffer,
+    reciprocal_scale: Buffer,
+    block: str,
+    rows: int,
+    width: int,
+) -> None:
+    """LayerNorm that also hands its int8 copy to the next carrier GEMM."""
+    quantized = context.builder.temporary_buffer(size_bytes=rows * width, alignment_bytes=256)
+    layer_norm_quantize(
+        context.builder,
+        context.kernels,
+        output,
+        quantized,
+        input_,
+        gammas,
+        betas,
+        reciprocal_scale,
+        LayerNormQuantizeSpecialization(rows, width, context.architecture),
+    )
+    _QUANTIZED[(context.batch_size, id(output), block)] = (output, quantized)
+
